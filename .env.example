# Copy to .env.local and fill in real values.
# Next.js loads .env.local automatically.

# ── Required: Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Groq ranks each job's top 10 applicants. https://console.groq.com
# Without a key, picks are ranked from skills, resume, and answers.
GROQ_API_KEY=
# AI_MODEL=openai/gpt-oss-120b

# ── Email notifications (optional) ─────────────────────────────────
# Pick ONE provider. With neither set, emails are skipped and logged as "skipped".
# Option A: Resend (https://resend.com) — simplest.
RESEND_API_KEY=
# Option B: SMTP (Gmail app password, Outlook, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# Sender shown to recipients. Must be a verified domain/address for your provider.
EMAIL_FROM=IoBM Career Portal <careers@yourdomain.edu.pk>
EMAIL_BRAND_NAME=IoBM Career Portal
# Absolute URL used for links inside emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Protects /api/cron/deadline-reminders (Vercel Cron sends this automatically when set).
CRON_SECRET=

